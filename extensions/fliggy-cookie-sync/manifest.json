{
  "manifest_version": 3,
  "name": "飞猪哨兵 · Cookie 同步",
  "short_name": "fliggy-cookie-sync",
  "version": "1.1.0",
  "description": "点一下工具栏图标，自动开手机尺寸窗口访问飞猪 H5 → 自动抓 mtop cookies → 自动上传到 VPS。",
  "action": {
    "default_title": "飞猪哨兵 Cookie 同步（点一下自动同步）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["cookies", "storage", "tabs", "windows", "alarms", "notifications", "scripting"],
  "host_permissions": [
    "https://*.taobao.com/*",
    "http://*.taobao.com/*",
    "https://*.tmall.com/*",
    "http://*.tmall.com/*",
    "https://*.fliggy.com/*",
    "http://*.fliggy.com/*",
    "https://*.alipay.com/*",
    "http://*.alipay.com/*",
    "https://feizhu.19880913.xyz/*",
    "https://*.19880913.xyz/*"
  ]
}